<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ============================================= -->
    <!-- Основная цветовая палитра                      -->
    <!-- ============================================= -->

    <!-- Primary colors -->
    <Color x:Key="Primary">#1976D2</Color>
    <Color x:Key="PrimaryDark">#42A5F5</Color>
    <Color x:Key="PrimaryLight">#BBDEFB</Color>

    <!-- Secondary colors -->
    <Color x:Key="Secondary">#7B1FA2</Color>
    <Color x:Key="SecondaryDark">#AB47BC</Color>
    <Color x:Key="SecondaryLight">#E1BEE7</Color>

    <!-- Neutral colors -->
    <Color x:Key="Neutral">#546E7A</Color>
    <Color x:Key="NeutralDark">#90A4AE</Color>
    <Color x:Key="NeutralLight">#CFD8DC</Color>

    <!-- White and Black -->
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>

    <!-- Background colors -->
    <Color x:Key="BackgroundLight">#F5F7FA</Color>
    <Color x:Key="BackgroundDark">#0D1117</Color>

    <!-- Surface colors -->
    <Color x:Key="SurfaceLight">#FFFFFF</Color>
    <Color x:Key="SurfaceDark">#1E1E2E</Color>

    <!-- Status colors -->
    <Color x:Key="Success">#43A047</Color>
    <Color x:Key="Warning">#FB8C00</Color>
    <Color x:Key="Danger">#E53935</Color>
    <Color x:Key="Info">#1E88E5</Color>

    <!-- Text colors -->
    <Color x:Key="TextPrimary">#212121</Color>
    <Color x:Key="TextSecondary">#546E7A</Color>
    <Color x:Key="TextDisabled">#90A4AE</Color>

    <!-- Dark theme text colors -->
    <Color x:Key="TextPrimaryDark">#ECEFF1</Color>
    <Color x:Key="TextSecondaryDark">#90A4AE</Color>
    <Color x:Key="TextDisabledDark">#546E7A</Color>

    <!-- Note: The line below is kept for backward compatibility -->
    <Color x:Key="Yellow100Accent">#F7B548</Color>
    <Color x:Key="Yellow200Accent">#FFD590</Color>
    <Color x:Key="Yellow300Accent">#FFE5B9</Color>
    <Color x:Key="Cyan100Accent">#28C2D1</Color>
    <Color x:Key="Cyan200Accent">#7BDDEF</Color>
    <Color x:Key="Cyan300Accent">#C3F2F4</Color>
    <Color x:Key="Blue100Accent">#3E8EED</Color>
    <Color x:Key="Blue200Accent">#72ACF1</Color>
    <Color x:Key="Blue300Accent">#A7CBF6</Color>

</ResourceDictionary>