<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HumidityNP.Views.VehiclesPage"
             Title="🚛 Список машин"
             x:Name="page">

    <!-- Ресурсы страницы: стили для карточек, кнопок и анимаций -->
    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Стиль для карточки машины -->
            <Style x:Key="VehicleCardFrame" TargetType="Frame">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFFFFF, Dark=#2A2A3A}" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="Margin" Value="12,6" />
                <Setter Property="HasShadow" Value="True" />
                <Setter Property="BorderColor" Value="{AppThemeBinding Light=#E0E0E0, Dark=#3A3A4A}" />
            </Style>

            <!-- Стиль для номера машины (главный текст) -->
            <Style x:Key="VehicleNumberLabel" TargetType="Label">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light=#1A237E, Dark=#90CAF9}" />
            </Style>

            <!-- Стиль для дополнительной информации (серый текст) -->
            <Style x:Key="VehicleInfoLabel" TargetType="Label">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light=#616161, Dark=#B0BEC5}" />
                <Setter Property="Margin" Value="0,2,0,0" />
            </Style>

            <!-- Стиль для бейджа (маленький цветной блок с текстом) -->
            <Style x:Key="BadgeFrame" TargetType="Frame">
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="HasShadow" Value="False" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <!-- Фоновый градиент для всей страницы -->
    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0,1">
                <GradientStop Color="{AppThemeBinding Light=#E3F2FD, Dark=#1A1A2E}" Offset="0" />
                <GradientStop Color="{AppThemeBinding Light=#BBDEFB, Dark=#16213E}" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <!-- Строка 0: Поиск -->
            <RowDefinition Height="Auto" />
            <!-- Строка 1: Заголовок с количеством -->
            <RowDefinition Height="Auto" />
            <!-- Строка 2: Список машин -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================================ -->
        <!-- ПОИСКОВАЯ СТРОКА                             -->
        <!-- ============================================ -->
        <Frame Grid.Row="0"
               Margin="12,12,12,0"
               Padding="12,8"
               CornerRadius="25"
               BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2A2A3A}"
               HasShadow="True"
               BorderColor="{AppThemeBinding Light=#E0E0E0, Dark=#3A3A4A}">
            <Grid ColumnDefinitions="Auto,*">
                <!-- Иконка лупы -->
                <Label Grid.Column="0"
                       Text="🔍"
                       FontSize="18"
                       VerticalOptions="Center"
                       Margin="0,0,10,0" />
                <!-- Поле ввода для поиска -->
                <Entry Grid.Column="1"
                       Placeholder="Поиск по номеру, марке или контрагенту..."
                       PlaceholderColor="{AppThemeBinding Light=#9E9E9E, Dark=#757575}"
                       TextColor="{AppThemeBinding Light=#212121, Dark=#E0E0E0}"
                       BackgroundColor="Transparent"
                       FontSize="14"
                       VerticalOptions="Center"
                       Text="{Binding SearchQuery, Mode=TwoWay}" />
            </Grid>
        </Frame>

        <!-- ============================================ -->
        <!-- ЗАГОЛОВОК С КОЛИЧЕСТВОМ МАШИН                -->
        <!-- ============================================ -->
        <Grid Grid.Row="1" Margin="16,12,16,4" ColumnDefinitions="*,Auto">
            <!-- Заголовок -->
            <Label Grid.Column="0"
                   Text="Машины на площадке"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#0D47A1, Dark=#64B5F6}"
                   VerticalOptions="Center" />
            <!-- Счётчик машин -->
            <Frame Grid.Column="1"
                   BackgroundColor="{AppThemeBinding Light=#1976D2, Dark=#42A5F5}"
                   CornerRadius="14"
                   Padding="10,4"
                   HasShadow="False">
                <Label Text="{Binding Vehicles.Count, StringFormat='🚛 {0}'}"
                       TextColor="White"
                       FontSize="13"
                       FontAttributes="Bold"
                       VerticalOptions="Center" />
            </Frame>
        </Grid>

        <!-- ============================================ -->
        <!-- СПИСОК МАШИН (COLLECTION VIEW)               -->
        <!-- ============================================ -->
        <RefreshView Grid.Row="2"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshCommand}">
            <CollectionView ItemsSource="{Binding Vehicles}"
                            SelectedItem="{Binding SelectedVehicle, Mode=TwoWay}"
                            SelectionMode="Single"
                            Margin="0,4,0,0">

                <!-- Пустое состояние: когда список машин пуст -->
                <CollectionView.EmptyView>
                    <Grid VerticalOptions="Center" HorizontalOptions="Center" Padding="40">
                        <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                            <Label Text="🚛"
                                   FontSize="60"
                                   HorizontalOptions="Center" />
                            <Label Text="Нет доступных машин"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#424242, Dark=#B0BEC5}"
                                   HorizontalOptions="Center" />
                            <Label Text="Потяните вниз для обновления"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light=#757575, Dark=#78909C}"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Grid>
                </CollectionView.EmptyView>

                <!-- Шаблон элемента списка -->
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <!-- Карточка машины с эффектом нажатия -->
                        <!-- ВАЖНО: InputTransparent="True" позволяет касаниям проходить сквозь Frame к CollectionView -->
                        <Frame Style="{StaticResource VehicleCardFrame}" InputTransparent="True">
                            <!-- Визуальное состояние при нажатии -->
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#E3F2FD, Dark=#1A237E}" />
                                            <Setter Property="BorderColor" Value="{AppThemeBinding Light=#1976D2, Dark=#42A5F5}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="4" InputTransparent="True">

                                <!-- ============================================ -->
                                <!-- ИКОНКА МАШИНЫ (левая часть)                  -->
                                <!-- ============================================ -->
                                <Frame Grid.Row="0" Grid.RowSpan="3" Grid.Column="0"
                                       WidthRequest="56" HeightRequest="56"
                                       CornerRadius="28"
                                       BackgroundColor="{AppThemeBinding Light=#E3F2FD, Dark=#1A237E}"
                                       HasShadow="False"
                                       Padding="0"
                                       VerticalOptions="Center"
                                       HorizontalOptions="Center"
                                       InputTransparent="True">
                                    <Label Text="🚛"
                                           FontSize="28"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Frame>

                                <!-- ============================================ -->
                                <!-- ОСНОВНАЯ ИНФОРМАЦИЯ (центр)                  -->
                                <!-- ============================================ -->

                                <!-- Номер машины и гос. номер -->
                                <Label Grid.Row="0" Grid.Column="1"
                                       Style="{StaticResource VehicleNumberLabel}"
                                       Text="{Binding DisplayName}"
                                       LineBreakMode="TailTruncation" />

                                <!-- Краткая информация: номер заявки | контрагент | вид работ -->
                                <Label Grid.Row="1" Grid.Column="1"
                                       Style="{StaticResource VehicleInfoLabel}"
                                       Text="{Binding Summary}"
                                       LineBreakMode="TailTruncation" />

                                <!-- Дополнительная информация: водитель и подразделение -->
                                <Label Grid.Row="2" Grid.Column="1"
                                       Style="{StaticResource VehicleInfoLabel}"
                                       FontSize="12"
                                       Text="{Binding Driver, StringFormat='👤 {0}'}"
                                       LineBreakMode="TailTruncation"
                                       IsVisible="{Binding Driver, Converter={StaticResource InverseBoolConverter}}" />

                                <!-- ============================================ -->
                                <!-- СТРЕЛКА ВПРАВО (правая часть)                -->
                                <!-- ============================================ -->
                                <Frame Grid.Row="0" Grid.RowSpan="3" Grid.Column="2"
                                       WidthRequest="36" HeightRequest="36"
                                       CornerRadius="18"
                                       BackgroundColor="{AppThemeBinding Light=#E8EAF6, Dark=#303F9F}"
                                       HasShadow="False"
                                       Padding="0"
                                       VerticalOptions="Center"
                                       HorizontalOptions="Center"
                                       InputTransparent="True">
                                    <Label Text="›"
                                           FontSize="22"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#1976D2, Dark=#90CAF9}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Frame>

                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>