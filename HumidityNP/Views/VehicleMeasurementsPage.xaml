<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:HumidityNP.Converters"
             x:Class="HumidityNP.Views.VehicleMeasurementsPage"
             Title="📊 Замеры"
             x:Name="page">

    <!-- Ресурсы страницы: конвертеры и стили -->
    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Конвертер для инверсии булевых значений -->
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />

            <!-- Стиль для карточки информации о машине -->
            <Style x:Key="VehicleInfoCard" TargetType="Frame">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFFFFF, Dark=#2A2A3A}" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="Margin" Value="12,8" />
                <Setter Property="HasShadow" Value="True" />
                <Setter Property="BorderColor" Value="{AppThemeBinding Light=#E0E0E0, Dark=#3A3A4A}" />
            </Style>

            <!-- Стиль для карточки данных с датчика -->
            <Style x:Key="SensorDataCard" TargetType="Frame">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFFFFF, Dark=#2A2A3A}" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="12,10" />
                <Setter Property="Margin" Value="12,4" />
                <Setter Property="HasShadow" Value="True" />
                <Setter Property="BorderColor" Value="{AppThemeBinding Light=#E0E0E0, Dark=#3A3A4A}" />
            </Style>

            <!-- Стиль для карточки замера в списке -->
            <Style x:Key="MeasurementCard" TargetType="Frame">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFFFFF, Dark=#2A2A3A}" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="14" />
                <Setter Property="Margin" Value="12,4" />
                <Setter Property="HasShadow" Value="True" />
                <Setter Property="BorderColor" Value="{AppThemeBinding Light=#E0E0E0, Dark=#3A3A4A}" />
            </Style>

            <!-- Стиль для кнопки "Зафиксировать" (зелёная, основная) -->
            <Style x:Key="CaptureButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#4CAF50" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="CornerRadius" Value="25" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="HeightRequest" Value="50" />
                <Setter Property="HorizontalOptions" Value="FillAndExpand" />
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="#4CAF50" />
                                    <Setter Property="Scale" Value="1" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="#388E3C" />
                                    <Setter Property="Scale" Value="0.97" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="#B0BEC5" />
                                    <Setter Property="TextColor" Value="#757575" />
                                    <Setter Property="Opacity" Value="0.6" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

            <!-- Стиль для кнопки "Вручную" (синяя, вторичная) -->
            <Style x:Key="ManualButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#2196F3" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="CornerRadius" Value="25" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="HeightRequest" Value="50" />
                <Setter Property="HorizontalOptions" Value="FillAndExpand" />
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="#2196F3" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="#1565C0" />
                                    <Setter Property="Scale" Value="0.97" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

            <!-- Стиль для кнопки подключения/отключения -->
            <Style x:Key="ConnectionButtonStyle" TargetType="Button">
                <Setter Property="TextColor" Value="White" />
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="16,8" />
                <Setter Property="HeightRequest" Value="40" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <!-- Фоновый градиент -->
    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0,1">
                <GradientStop Color="{AppThemeBinding Light=#E3F2FD, Dark=#1A1A2E}" Offset="0" />
                <GradientStop Color="{AppThemeBinding Light=#BBDEFB, Dark=#16213E}" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <!-- Строка 0: Информация о машине -->
            <RowDefinition Height="Auto" />
            <!-- Строка 1: Статус подключения -->
            <RowDefinition Height="Auto" />
            <!-- Строка 2: Данные с датчика -->
            <RowDefinition Height="Auto" />
            <!-- Строка 3: Кнопки управления -->
            <RowDefinition Height="Auto" />
            <!-- Строка 4: Заголовок списка замеров -->
            <RowDefinition Height="Auto" />
            <!-- Строка 5: Список замеров -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================================ -->
        <!-- КАРТОЧКА ИНФОРМАЦИИ О МАШИНЕ                 -->
        <!-- ============================================ -->
        <Frame Grid.Row="0" Style="{StaticResource VehicleInfoCard}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                <!-- Иконка машины -->
                <Frame Grid.Row="0" Grid.RowSpan="3" Grid.Column="0"
                       WidthRequest="52" HeightRequest="52"
                       CornerRadius="26"
                       BackgroundColor="{AppThemeBinding Light=#E3F2FD, Dark=#1A237E}"
                       HasShadow="False"
                       Padding="0"
                       VerticalOptions="Center">
                    <Label Text="🚛"
                           FontSize="26"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Frame>

                <!-- Название машины (марка + номер) -->
                <Label Grid.Row="0" Grid.Column="1"
                       Text="{Binding Vehicle.DisplayName}"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#1A237E, Dark=#90CAF9}"
                       LineBreakMode="TailTruncation" />

                <!-- Краткая информация -->
                <Label Grid.Row="1" Grid.Column="1"
                       Text="{Binding Vehicle.Summary}"
                       FontSize="13"
                       TextColor="{AppThemeBinding Light=#616161, Dark=#B0BEC5}"
                       LineBreakMode="TailTruncation" />

                <!-- Контрагент -->
                <Label Grid.Row="2" Grid.Column="1"
                       Text="{Binding Vehicle.Counterparty, StringFormat='🏢 {0}'}"
                       FontSize="12"
                       TextColor="{AppThemeBinding Light=#757575, Dark=#78909C}"
                       LineBreakMode="TailTruncation" />
            </Grid>
        </Frame>

        <!-- ============================================ -->
        <!-- СТАТУС ПОДКЛЮЧЕНИЯ К BLE                     -->
        <!-- ============================================ -->
        <Frame Grid.Row="1"
               Margin="12,0"
               Padding="14,10"
               CornerRadius="12"
               BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2A2A3A}"
               HasShadow="True"
               BorderColor="{AppThemeBinding Light=#E0E0E0, Dark=#3A3A4A}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <!-- Индикатор состояния (цветной кружок) -->
                <Grid Grid.Column="0" WidthRequest="16" HeightRequest="16" VerticalOptions="Center">
                    <!-- Внешнее свечение -->
                    <Ellipse WidthRequest="16" HeightRequest="16"
                             Fill="{Binding IsConnected, Converter={StaticResource BoolToColorConverter}}"
                             Opacity="0.3" />
                    <!-- Внутренний кружок -->
                    <Ellipse WidthRequest="10" HeightRequest="10"
                             Fill="{Binding IsConnected, Converter={StaticResource BoolToColorConverter}}"
                             HorizontalOptions="Center"
                             VerticalOptions="Center" />
                </Grid>

                <!-- Текст статуса -->
                <Label Grid.Column="1"
                       Text="{Binding ConnectionStatus}"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#212121, Dark=#E0E0E0}"
                       VerticalOptions="Center" />

                <!-- Кнопка подключения/отключения -->
                <Button Grid.Column="2"
                        Style="{StaticResource ConnectionButtonStyle}"
                        Text="{Binding IsConnected, StringFormat='{0:🔌 Подключиться;⚡ Отключиться}'}">
                    <Button.BackgroundColor>
                        <Binding Path="IsConnected" Converter="{StaticResource BoolToColorConverter}" ConverterParameter="button" />
                    </Button.BackgroundColor>
                    <Button.Command>
                        <Binding Path="ConnectCommand" />
                    </Button.Command>
                </Button>
            </Grid>
        </Frame>

        <!-- ============================================ -->
        <!-- КАРТОЧКА ДАННЫХ С ДАТЧИКА (СЖАТАЯ ВЕРСИЯ)    -->
        <!-- ============================================ -->
        <Frame Grid.Row="2" Style="{StaticResource SensorDataCard}">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="4">
                <!-- Заголовок секции -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
                    <Label Grid.Column="0" Text="📡" FontSize="18" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="Данные с датчика" FontSize="15" FontAttributes="Bold" 
                           TextColor="{AppThemeBinding Light=#0D47A1, Dark=#90CAF9}" VerticalOptions="Center" Margin="6,0,0,0" />
                </Grid>

                <!-- ВЛАЖНОСТЬ -->
                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <Frame Grid.Column="0" WidthRequest="36" HeightRequest="36" CornerRadius="18"
                           BackgroundColor="{AppThemeBinding Light=#E3F2FD, Dark=#0D47A1}" HasShadow="False" Padding="0" VerticalOptions="Center">
                        <Label Text="💧" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Frame>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0">
                        <Label Text="Влажность" FontSize="11" TextColor="{AppThemeBinding Light=#757575, Dark=#78909C}" />
                        <Label Text="{Binding CurrentHumidity}" FontSize="22" FontAttributes="Bold" 
                               TextColor="{AppThemeBinding Light=#0D47A1, Dark=#64B5F6}" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="{Binding CurrentSign}" FontSize="22" FontAttributes="Bold" 
                           TextColor="Red" VerticalOptions="Center" HorizontalOptions="End" />
                </Grid>

                <!-- ТЕМПЕРАТУРА -->
                <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <Frame Grid.Column="0" WidthRequest="32" HeightRequest="32" CornerRadius="16"
                           BackgroundColor="{AppThemeBinding Light=#FFF3E0, Dark=#4E342E}" HasShadow="False" Padding="0" VerticalOptions="Center">
                        <Label Text="🌡️" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Frame>
                    <Label Grid.Column="1" Text="Температура" FontSize="12" 
                           TextColor="{AppThemeBinding Light=#757575, Dark=#78909C}" VerticalOptions="Center" />
                    <Label Grid.Column="2" Text="{Binding CurrentTemperature}" FontSize="14" FontAttributes="Bold" 
                           TextColor="{AppThemeBinding Light=#E65100, Dark=#FFB74D}" VerticalOptions="Center" />
                </Grid>

                <!-- МАТЕРИАЛ -->
                <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <Frame Grid.Column="0" WidthRequest="32" HeightRequest="32" CornerRadius="16"
                           BackgroundColor="{AppThemeBinding Light=#E8F5E9, Dark=#1B5E20}" HasShadow="False" Padding="0" VerticalOptions="Center">
                        <Label Text="🧱" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Frame>
                    <Label Grid.Column="1" Text="Материал" FontSize="12" 
                           TextColor="{AppThemeBinding Light=#757575, Dark=#78909C}" VerticalOptions="Center" />
                    <Label Grid.Column="2" Text="{Binding CurrentMaterial}" FontSize="13" FontAttributes="Bold" 
                           TextColor="{AppThemeBinding Light=#212121, Dark=#E0E0E0}" VerticalOptions="Center" />
                </Grid>

                <!-- Тип и время в одну строку -->
                <Grid Grid.Row="4" ColumnDefinitions="*,*" Margin="38,0,0,0">
                    <Label Grid.Column="0" Text="{Binding CurrentMeasurementType, StringFormat='Тип: {0}'}"
                           FontSize="11" TextColor="{AppThemeBinding Light=#9E9E9E, Dark=#616161}" />
                    <Label Grid.Column="1" Text="{Binding LastDataTime, StringFormat='🕐 {0:HH:mm:ss}'}"
                           FontSize="11" TextColor="{AppThemeBinding Light=#9E9E9E, Dark=#616161}" 
                           IsVisible="{Binding IsDataAvailable}" HorizontalOptions="End" />
                </Grid>

                <!-- Сообщение "Нет данных" -->
                <Frame Grid.Row="5" IsVisible="{Binding IsDataAvailable, Converter={StaticResource InverseBoolConverter}}"
                       BackgroundColor="{AppThemeBinding Light=#FFF8E1, Dark=#3E2723}"
                       CornerRadius="8" Padding="10,6" HasShadow="False" Margin="0,4,0,0">
                    <Label Text="⏳ Ожидание данных с датчика..." FontSize="12"
                           TextColor="{AppThemeBinding Light=#F57F17, Dark=#FFB74D}" HorizontalOptions="Center" />
                </Frame>
            </Grid>
        </Frame>

        <!-- ============================================ -->
        <!-- КНОПКИ УПРАВЛЕНИЯ                            -->
        <!-- ============================================ -->
        <Grid Grid.Row="3" Margin="12,4" ColumnDefinitions="*,*" ColumnSpacing="10">
            <!-- Кнопка "Зафиксировать" (сохранить текущие данные с датчика) -->
            <Button Grid.Column="0"
                    Text="✅ Зафиксировать"
                    Style="{StaticResource CaptureButtonStyle}"
                    IsEnabled="{Binding CanCapture}"
                    Command="{Binding CaptureReadingCommand}" />

            <!-- Кнопка "Вручную" (ввести значение вручную) -->
            <Button Grid.Column="1"
                    Text="✋ Вручную"
                    Style="{StaticResource ManualButtonStyle}"
                    Command="{Binding AddManualMeasurementCommand}" />
        </Grid>

        <!-- ============================================ -->
        <!-- ЗАГОЛОВОК СПИСКА ЗАМЕРОВ                     -->
        <!-- ============================================ -->
        <Grid Grid.Row="4" Margin="16,4,16,2" ColumnDefinitions="*,Auto">
            <Label Grid.Column="0"
                   Text="📋 История замеров"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#0D47A1, Dark=#64B5F6}"
                   VerticalOptions="Center" />
            <!-- Счётчик замеров -->
            <Frame Grid.Column="1"
                   BackgroundColor="{AppThemeBinding Light=#E8EAF6, Dark=#303F9F}"
                   CornerRadius="12"
                   Padding="8,3"
                   HasShadow="False">
                <Label Text="{Binding Measurements.Count, StringFormat='{0} шт.'}"
                       TextColor="{AppThemeBinding Light=#1A237E, Dark=#90CAF9}"
                       FontSize="12"
                       FontAttributes="Bold" />
            </Frame>
        </Grid>

        <!-- ============================================ -->
        <!-- СПИСОК СОХРАНЁННЫХ ЗАМЕРОВ                   -->
        <!-- ============================================ -->
        <RefreshView Grid.Row="5"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding LoadDataCommand}">
            <CollectionView ItemsSource="{Binding Measurements}"
                            SelectionMode="None">

                <!-- Пустое состояние -->
                <CollectionView.EmptyView>
                    <Grid VerticalOptions="Center" HorizontalOptions="Center" Padding="40">
                        <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                            <Label Text="📋"
                                   FontSize="50"
                                   HorizontalOptions="Center" />
                            <Label Text="Пока нет замеров"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#424242, Dark=#B0BEC5}"
                                   HorizontalOptions="Center" />
                            <Label Text="Зафиксируйте первое измерение"
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light=#757575, Dark=#78909C}"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Grid>
                </CollectionView.EmptyView>

                <!-- Шаблон элемента списка замеров -->
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <!-- SwipeView для жеста удаления свайпом влево -->
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem Text="🗑️ Удалить"
                                               BackgroundColor="#D32F2F"
                                               Command="{Binding BindingContext.DeleteMeasurementCommand, Source={x:Reference page}}"
                                               CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.RightItems>

                            <!-- Карточка замера -->
                            <Frame Style="{StaticResource MeasurementCard}">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">

                                    <!-- Индикатор источника (иконка) -->
                                    <Frame Grid.Row="0" Grid.RowSpan="3" Grid.Column="0"
                                           WidthRequest="44" HeightRequest="44"
                                           CornerRadius="22"
                                           HasShadow="False"
                                           Padding="0"
                                           VerticalOptions="Center">
                                        <!-- Цвет зависит от источника: Auto = синий, Manual = оранжевый -->
                                        <Frame.BackgroundColor>
                                            <Binding Path="Source">
                                                <Binding.Converter>
                                                    <converters:BoolToColorConverter />
                                                </Binding.Converter>
                                            </Binding>
                                        </Frame.BackgroundColor>
                                        <Label FontSize="20"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center">
                                            <Label.Text>
                                                <MultiBinding StringFormat="{}{0}">
                                                    <Binding Path="Source">
                                                        <Binding.Converter>
                                                            <converters:SourceToIconConverter />
                                                        </Binding.Converter>
                                                    </Binding>
                                                </MultiBinding>
                                            </Label.Text>
                                        </Label>
                                    </Frame>

                                    <!-- Значение влажности -->
                                    <Label Grid.Row="0" Grid.Column="1"
                                           Text="{Binding DisplayValue}"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#0D47A1, Dark=#64B5F6}" />

                                    <!-- Дата и время замера -->
                                    <Label Grid.Row="1" Grid.Column="1"
                                           Text="{Binding Timestamp, StringFormat='{0:dd.MM.yyyy HH:mm:ss}'}"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light=#757575, Dark=#78909C}" />

                                    <!-- Источник данных -->
                                    <Label Grid.Row="2" Grid.Column="1"
                                           Text="{Binding SourceDisplay}"
                                           FontSize="11"
                                           TextColor="{AppThemeBinding Light=#9E9E9E, Dark=#616161}" />

                                    <!-- Температура -->
                                    <VerticalStackLayout Grid.Row="0" Grid.RowSpan="2" Grid.Column="2"
                                                         VerticalOptions="Center" HorizontalOptions="End" Spacing="2">
                                        <Label Text="{Binding TemperatureC, StringFormat='{0:F1}°C'}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light=#E65100, Dark=#FFB74D}"
                                               HorizontalOptions="End" />
                                    </VerticalStackLayout>

                                    <!-- Материал -->
                                    <Label Grid.Row="2" Grid.Column="2"
                                           Text="{Binding Material}"
                                           FontSize="11"
                                           TextColor="{AppThemeBinding Light=#9E9E9E, Dark=#616161}"
                                           VerticalOptions="Center"
                                           HorizontalOptions="End" />
                                </Grid>
                            </Frame>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>