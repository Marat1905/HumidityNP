<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:HumidityNP.Converters"
             x:Class="HumidityNP.Views.AllMeasurementsPage"
             Title="📋 Все замеры"
             x:Name="page">

    <!-- Ресурсы страницы: конвертеры и стили -->
    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Конвертер для иконок источников замера -->
            <converters:SourceToIconConverter x:Key="SourceToIconConverter" />

            <!-- Конвертер для цветов источников замера -->
            <converters:BoolToColorConverter x:Key="BoolToColorConverter" />

            <!-- Стиль для карточки замера -->
            <Style x:Key="MeasurementCard" TargetType="Frame">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFFFFF, Dark=#2A2A3A}" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="14" />
                <Setter Property="Margin" Value="12,4" />
                <Setter Property="HasShadow" Value="True" />
                <Setter Property="BorderColor" Value="{AppThemeBinding Light=#E0E0E0, Dark=#3A3A4A}" />
            </Style>

            <!-- Стиль для кнопки выгрузки -->
            <Style x:Key="UploadButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#4CAF50" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="CornerRadius" Value="25" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="HeightRequest" Value="50" />
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="#4CAF50" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="#388E3C" />
                                    <Setter Property="Scale" Value="0.97" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="#B0BEC5" />
                                    <Setter Property="TextColor" Value="#757575" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <!-- Фоновый градиент -->
    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0,1">
                <GradientStop Color="{AppThemeBinding Light=#E3F2FD, Dark=#1A1A2E}" Offset="0" />
                <GradientStop Color="{AppThemeBinding Light=#BBDEFB, Dark=#16213E}" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <!-- Строка 0: Кнопка выгрузки -->
            <RowDefinition Height="Auto" />
            <!-- Строка 1: Заголовок с количеством -->
            <RowDefinition Height="Auto" />
            <!-- Строка 2: Список замеров -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================================ -->
        <!-- КНОПКА ВЫГРУЗКИ ВСЕХ ЗАМЕРОВ НА СЕРВЕР       -->
        <!-- ============================================ -->
        <Frame Grid.Row="0"
               Margin="12,12,12,4"
               Padding="16,12"
               CornerRadius="16"
               BackgroundColor="{AppThemeBinding Light=#E8F5E9, Dark=#1B5E20}"
               HasShadow="True"
               BorderColor="{AppThemeBinding Light=#C8E6C9, Dark=#2E7D32}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <!-- Иконка -->
                <Frame Grid.Column="0"
                       WidthRequest="44" HeightRequest="44"
                       CornerRadius="22"
                       BackgroundColor="#4CAF50"
                       HasShadow="False"
                       Padding="0"
                       VerticalOptions="Center">
                    <Label Text="☁️"
                           FontSize="22"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Frame>

                <!-- Текст-подсказка -->
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                    <Label Text="Выгрузить на сервер"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#1B5E20, Dark=#A5D6A7}" />
                    <Label Text="Все локальные замеры будут отправлены"
                           FontSize="11"
                           TextColor="{AppThemeBinding Light=#388E3C, Dark=#81C784}" />
                </VerticalStackLayout>

                <!-- Кнопка выгрузки -->
                <Button Grid.Column="2"
                        Text="📤 Выгрузить"
                        Style="{StaticResource UploadButtonStyle}"
                        Command="{Binding UploadAllCommand}"
                        HeightRequest="44"
                        Padding="16,0"
                        VerticalOptions="Center" />
            </Grid>
        </Frame>

        <!-- ============================================ -->
        <!-- ЗАГОЛОВОК СПИСКА С КОЛИЧЕСТВОМ               -->
        <!-- ============================================ -->
        <Grid Grid.Row="1" Margin="16,8,16,4" ColumnDefinitions="*,Auto">
            <Label Grid.Column="0"
                   Text="📋 Локальные замеры"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#0D47A1, Dark=#64B5F6}"
                   VerticalOptions="Center" />
            <!-- Счётчик замеров -->
            <Frame Grid.Column="1"
                   BackgroundColor="{AppThemeBinding Light=#E8EAF6, Dark=#303F9F}"
                   CornerRadius="12"
                   Padding="8,3"
                   HasShadow="False">
                <Label Text="{Binding Measurements.Count, StringFormat='{0} шт.'}"
                       TextColor="{AppThemeBinding Light=#1A237E, Dark=#90CAF9}"
                       FontSize="12"
                       FontAttributes="Bold" />
            </Frame>
        </Grid>

        <!-- ============================================ -->
        <!-- СПИСОК ВСЕХ ЗАМЕРОВ                          -->
        <!-- ============================================ -->
        <RefreshView Grid.Row="2"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshCommand}">
            <CollectionView ItemsSource="{Binding Measurements}"
                            SelectionMode="None">

                <!-- Пустое состояние -->
                <CollectionView.EmptyView>
                    <Grid VerticalOptions="Center" HorizontalOptions="Center" Padding="40">
                        <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                            <Label Text="📋"
                                   FontSize="50"
                                   HorizontalOptions="Center" />
                            <Label Text="Нет локальных замеров"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#424242, Dark=#B0BEC5}"
                                   HorizontalOptions="Center" />
                            <Label Text="Все замеры выгружены на сервер"
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light=#757575, Dark=#78909C}"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Grid>
                </CollectionView.EmptyView>

                <!-- Шаблон элемента списка замеров -->
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <!-- SwipeView для жеста удаления свайпом влево -->
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem Text="🗑️ Удалить"
                                               BackgroundColor="#D32F2F"
                                               Command="{Binding BindingContext.DeleteMeasurementCommand, Source={x:Reference page}}"
                                               CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.RightItems>

                            <!-- Карточка замера -->
                            <Frame Style="{StaticResource MeasurementCard}">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">

                                    <!-- Индикатор источника (иконка в круге) -->
                                    <Frame Grid.Row="0" Grid.RowSpan="3" Grid.Column="0"
                                           WidthRequest="44" HeightRequest="44"
                                           CornerRadius="22"
                                           HasShadow="False"
                                           Padding="0"
                                           VerticalOptions="Center"
                                           BackgroundColor="{Binding Source, Converter={StaticResource BoolToColorConverter}}">
                                        <!-- Иконка зависит от источника: 📡 для Auto, ✋ для Manual -->
                                        <Label Text="{Binding Source, Converter={StaticResource SourceToIconConverter}}"
                                               FontSize="20"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                    </Frame>

                                    <!-- Значение влажности -->
                                    <Label Grid.Row="0" Grid.Column="1"
                                           Text="{Binding DisplayValue}"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#0D47A1, Dark=#64B5F6}" />

                                    <!-- Дата и время замера -->
                                    <Label Grid.Row="1" Grid.Column="1"
                                           Text="{Binding Timestamp, StringFormat='{0:dd.MM.yyyy HH:mm:ss}'}"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light=#757575, Dark=#78909C}" />

                                    <!-- Источник данных и ID машины -->
                                    <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
                                        <Label Grid.Column="0"
                                               Text="{Binding SourceDisplay}"
                                               FontSize="11"
                                               TextColor="{AppThemeBinding Light=#9E9E9E, Dark=#616161}" />
                                        <Label Grid.Column="1"
                                               Text="{Binding VehicleId}"
                                               FontSize="11"
                                               TextColor="{AppThemeBinding Light=#9E9E9E, Dark=#616161}"
                                               TextDecorations="Underline" />
                                    </Grid>

                                    <!-- Температура -->
                                    <VerticalStackLayout Grid.Row="0" Grid.RowSpan="2" Grid.Column="2"
                                                         VerticalOptions="Center" HorizontalOptions="End" Spacing="2">
                                        <Label Text="{Binding TemperatureC, StringFormat='{0:F1}°C'}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light=#E65100, Dark=#FFB74D}"
                                               HorizontalOptions="End" />
                                    </VerticalStackLayout>

                                    <!-- Материал -->
                                    <Label Grid.Row="2" Grid.Column="2"
                                           Text="{Binding Material}"
                                           FontSize="11"
                                           TextColor="{AppThemeBinding Light=#9E9E9E, Dark=#616161}"
                                           VerticalOptions="Center"
                                           HorizontalOptions="End" />
                                </Grid>
                            </Frame>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>