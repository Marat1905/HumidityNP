<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:HumidityNP.Views"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    Shell.FlyoutBehavior="Disabled"
    x:Class="HumidityNP.AppShell">

    <!-- ============================================ -->
    <!-- КНОПКА ПЕРЕКЛЮЧЕНИЯ ТЕМЫ                     -->
    <!-- ============================================ -->
    <Shell.ToolbarItems>
        <ToolbarItem x:Name="ThemeToggleItem" 
                     Text="🌓 Тема" 
                     Clicked="OnThemeToggleClicked" 
                     Order="Primary" />
    </Shell.ToolbarItems>

    <TabBar>
        <!-- Иконка "car" из Material Icons -->
        <Tab Title="Машины" mi:MauiIcon.Value="{mi:Material Icon=DirectionsCar}">
            <ShellContent ContentTemplate="{DataTemplate local:VehiclesPage}" Route="vehicles" />
        </Tab>

        <!-- Иконка "list" из Material Icons -->
        <Tab Title="Все замеры" mi:MauiIcon.Value="{mi:Material Icon=ListAlt}">
            <ShellContent ContentTemplate="{DataTemplate local:AllMeasurementsPage}" Route="allmeasurements" />
        </Tab>

        <!-- Новая вкладка для разгрузок -->
        <Tab Title="Разгрузки" mi:MauiIcon.Value="{mi:Material Icon=Inventory}">
            <ShellContent ContentTemplate="{DataTemplate local:AllUnloadsPage}" Route="allunloads" />
        </Tab>
    </TabBar>

</Shell>