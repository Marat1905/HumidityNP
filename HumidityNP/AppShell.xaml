<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:local="clr-namespace:HumidityNP.Views"
       x:Class="HumidityNP.AppShell">
    <TabBar>
        <Tab Title="Машины" Icon="car.png">
            <ShellContent ContentTemplate="{DataTemplate local:VehiclesPage}" Route="vehicles" />
        </Tab>
        <Tab Title="Все замеры" Icon="list.png">
            <ShellContent ContentTemplate="{DataTemplate local:AllMeasurementsPage}" Route="allmeasurements" />
        </Tab>
    </TabBar>
</Shell>